---
// A still credits strip: the games and teams worked on, in one quiet line.
const { items = [], label = "Highlights" } = Astro.props;
---

<div class="ticker" role="region" aria-label={label}>
  <ul class="ticker__list">
    {
      items.map((item: string) => (
        <li class="ticker__item">{item}</li>
      ))
    }
  </ul>
</div>

<style>
  .ticker {
    position: relative;
    z-index: var(--z-base);
    padding: clamp(1.25rem, 3vw, 2rem) var(--gutter);
    border-block: 1px solid var(--border);
    background: var(--bg);
  }

  .ticker__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) 0;
    max-width: var(--container-max);
    margin-inline: auto;
  }

  .ticker__item {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.9rem + 0.6vw, 1.35rem);
    letter-spacing: var(--tracking-tight);
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .ticker__item + .ticker__item::before {
    content: "";
    width: 4px;
    height: 4px;
    margin-inline: clamp(0.9rem, 2.2vw, 1.75rem);
    border-radius: 50%;
    background: var(--border-strong);
  }

  .ticker__item:nth-child(even) {
    font-family: var(--font-serif);
    font-style: italic;
    letter-spacing: 0;
  }
</style>
