---
// "TL;DR" dialog: the 30-second version for recruiters and hiring managers.
// Native <dialog>: focus trap, Escape to close and backdrop come for free.
import { profile, bookingHref } from "../../data/profile.js";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const linkedin = profile.links.find((link) => link.label === "LinkedIn");

const facts = [
  { label: "Target", value: "PM · Consumer apps & gaming" },
  { label: "Experience", value: "8 years" },
  { label: "Based in", value: profile.location },
  { label: "Current role", value: "Senior Product Analyst, acting PM" },
];
---

<dialog class="brief" id="brief" aria-labelledby="brief-title" data-brief>
  <div class="brief__inner">
    <header class="brief__head">
      <span class="mono">The 30-second version</span>
      <button class="brief__close" type="button" data-brief-close aria-label="Close summary">
        <span aria-hidden="true">✕</span>
      </button>
    </header>

    <h2 class="brief__title" id="brief-title">
      {profile.name}: product analyst and <span class="serif">AI builder</span>, moving into PM.
    </h2>

    <ul class="brief__pitch">
      {profile.pitch.map((line) => <li>{line}</li>)}
    </ul>

    <dl class="brief__facts">
      {
        facts.map((fact) => (
          <div>
            <dt class="mono">{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="brief__actions">
      <a class="button button--primary" href={`${base}${profile.resumePdf}`} download>Resume (PDF)</a>
      <button class="button" type="button" data-copy={profile.contact.email}>
        <span data-copy-label>Copy email</span>
      </button>
      {linkedin && <a class="button" href={linkedin.href} rel="noopener">LinkedIn</a>}
      <a class="button button--ghost" href={bookingHref}>Book a call</a>
    </div>
  </div>
</dialog>

<style>
  .brief {
    width: min(40rem, calc(100vw - 2rem));
    max-height: calc(100svh - 2rem);
    margin: auto;
    padding: 0;
    color: var(--text);
    background: var(--bg-elev);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    overflow: auto;
  }

  .brief::backdrop {
    background: rgba(5, 5, 6, 0.72);
    backdrop-filter: blur(6px);
  }

  .brief[open] {
    animation: brief-in var(--dur) var(--ease-out);
  }

  @keyframes brief-in {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.98);
    }
  }

  .brief__inner {
    display: grid;
    gap: var(--space-5);
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }

  .brief__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brief__head .mono {
    color: var(--accent);
  }

  .brief__close {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    color: var(--text-secondary);
    transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }

  .brief__close:hover {
    color: var(--text);
    border-color: var(--text-tertiary);
  }

  .brief__title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.25rem);
    line-height: 1.05;
    letter-spacing: var(--tracking-tighter);
  }

  .brief__title .serif {
    color: var(--accent);
  }

  .brief__pitch {
    display: grid;
    gap: var(--space-3);
  }

  .brief__pitch li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--text-secondary);
  }

  .brief__pitch li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 6px;
    height: 6px;
    background: var(--accent);
  }

  .brief__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-block: 1px solid var(--border);
  }

  .brief__facts dd {
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
  }

  .brief__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (prefers-reduced-motion: reduce) {
    .brief[open] {
      animation: none;
    }
  }
</style>
