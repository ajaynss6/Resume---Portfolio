---
import "@fontsource-variable/inter";
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/jetbrains-mono";
import "@fontsource/instrument-serif/latin-400-italic.css";

import Background from "./Background.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { profile } from "../../data/profile.js";
import "../../styles/global.css";

const {
  title = `${profile.name} — ${profile.headline}`,
  description = profile.summary,
} = Astro.props;

const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.href;

const linkedin = profile.links.find((link) => link.label === "LinkedIn");

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.headline,
  description: profile.summary,
  email: `mailto:${profile.contact.email}`,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Hyderabad",
    addressCountry: "IN",
  },
  url: canonical,
  ...(linkedin ? { sameAs: [linkedin.href] } : {}),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#08090a" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}favicon.svg`}
    />

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.name} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(personSchema)}
    />

    <!-- Enable JS-only motion states without a flash of hidden content, plus a
         failsafe that reveals everything if the motion bundle never loads. -->
    <script is:inline>
      document.documentElement.classList.add("js");
      window.setTimeout(function () {
        var root = document.documentElement;
        if (!root.classList.contains("motion-ready")) {
          root.classList.add("motion-fallback");
        }
      }, 2500);
    </script>
    <noscript>
      <style>
        [data-reveal],
        [data-split-word] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Background />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import "../../scripts/motion-system.js";
      import "../../scripts/nav.js";
    </script>
  </body>
</html>