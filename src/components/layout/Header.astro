---
import navigation from "../../data/navigation.js";
import { profile } from "../../data/profile.js";

const linkedin = profile.links.find((link) => link.label === "LinkedIn");
---

<header class="site-header" data-header>
  <div class="hud" data-hud>
    <span class="hud__glow" aria-hidden="true"></span>
    <span class="hud__progress" data-scroll-progress aria-hidden="true"></span>

    <a class="hud__brand" href="#top" aria-label={`${profile.name} — back to top`}>
      <span class="hud__mark" aria-hidden="true">AJ</span>
      <span class="hud__name">{profile.name}</span>
    </a>

    <nav class="hud__nav" aria-label="Primary">
      <span class="hud__pill" data-nav-pill aria-hidden="true"></span>
      <ul class="hud__nav-list">
        {
          navigation.map((item) => (
            <li>
              <a class="hud__link" href={`#${item.id}`} data-nav-link={item.id}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hud__right">
      <span class="hud__status" aria-label="Local time in Hyderabad">
        <span class="hud__dot" aria-hidden="true"></span>
        <span class="hud__time" data-clock-time>--:--</span>
        <span class="hud__tz" aria-hidden="true">IST</span>
      </span>

      <a class="hud__cta" href={`mailto:${profile.contact.email}`}>
        <span class="hud__cta-text">Get in touch</span>
        <svg class="hud__cta-arrow" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
          <path d="M3 8h9M8.5 4.5 12 8l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>

      <button
        class="hud__menu"
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="hud__menu-label" data-menu-label>Menu</span>
        <span class="hud__menu-bars" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-menu>
    <nav class="mobile-menu__inner container" aria-label="Mobile">
      <ul class="mobile-menu__list">
        {
          navigation.map((item) => (
            <li class="mobile-menu__item" data-menu-item>
              <a class="mobile-menu__link" href={`#${item.id}`}>
                <span class="mobile-menu__index">{item.index}</span>
                <span class="mobile-menu__label">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mobile-menu__foot" data-menu-item>
        <a class="text-link" href={`mailto:${profile.contact.email}`}>
          {profile.contact.email}
        </a>
        {
          linkedin && (
            <a class="text-link" href={linkedin.href} rel="noopener">
              {linkedin.label}
            </a>
          )
        }
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-sticky);
    padding: 1rem var(--gutter) 0;
    pointer-events: none;
  }

  .hud {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    width: 100%;
    max-width: 72rem;
    height: 3.5rem;
    margin-inline: auto;
    padding: 0.4rem 0.5rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--bg-elev) 86%, transparent);
    backdrop-filter: blur(22px) saturate(150%);
    -webkit-backdrop-filter: blur(22px) saturate(150%);
    box-shadow:
      var(--shadow-md),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    overflow: hidden;
    pointer-events: auto;
    transition:
      height var(--dur) var(--ease-out),
      background var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }

  .site-header.is-scrolled .hud {
    height: 3.125rem;
    background: color-mix(in srgb, var(--bg-elev-2) 94%, transparent);
    border-color: rgba(255, 255, 255, 0.12);
  }

  /* Cursor-following sheen */
  .hud__glow {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      200px circle at var(--mx, 50%) var(--my, 50%),
      var(--accent-soft),
      transparent 62%
    );
    transition: opacity var(--dur) var(--ease-out);
  }

  .hud:hover .hud__glow {
    opacity: 1;
  }

  /* Scroll progress, integrated into the capsule edge */
  .hud__progress {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1.5px;
    background: linear-gradient(90deg, var(--accent-line), var(--accent-strong));
    transform: scaleX(0);
    transform-origin: left center;
    will-change: transform;
  }

  /* --- Brand ----------------------------------------------------------- */
  .hud__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    flex-shrink: 0;
    padding-inline: 0.35rem;
  }

  .hud__mark {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--accent-strong);
    border: 1px solid var(--border-strong);
    border-radius: 0.55rem;
    transition: border-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }

  .hud__brand:hover .hud__mark {
    border-color: var(--accent-line);
    color: #fff;
  }

  .hud__name {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-tight);
    white-space: nowrap;
    overflow: hidden;
    max-width: 12rem;
    transition:
      max-width var(--dur-slow) var(--ease-out),
      opacity var(--dur) var(--ease-out);
  }

  .site-header.is-scrolled .hud__name {
    max-width: 0;
    opacity: 0;
  }

  /* --- Nav with sliding indicator -------------------------------------- */
  .hud__nav {
    position: relative;
    margin-inline: auto;
  }

  .hud__nav-list {
    display: flex;
    align-items: center;
    position: relative;
  }

  .hud__link {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    height: 2.5rem;
    padding-inline: 0.9rem;
    font-size: var(--text-sm);
    color: var(--text-secondary);
    border-radius: var(--radius-pill);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .hud__link:hover {
    color: var(--text);
  }

  .hud__link.is-active {
    color: var(--text);
  }

  .hud__pill {
    position: absolute;
    top: 50%;
    left: 0;
    width: 3rem;
    height: 2.5rem;
    translate: 0 -50%;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    background: var(--surface-hover);
    opacity: 0;
    pointer-events: none;
  }

  /* --- Right cluster --------------------------------------------------- */
  .hud__right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .hud__status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding-inline: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--text-tertiary);
  }

  .hud__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 var(--accent-soft);
    animation: hud-pulse 2.6s var(--ease-in-out) infinite;
  }

  @keyframes hud-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(142, 166, 255, 0.45);
    }
    70% {
      box-shadow: 0 0 0 6px rgba(142, 166, 255, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(142, 166, 255, 0);
    }
  }

  .hud__time {
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .hud__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 2.5rem;
    padding-inline: 1rem;
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--text-inverse);
    background: var(--accent-strong);
    border-radius: var(--radius-pill);
    transition: background var(--dur-fast) var(--ease-out);
  }

  .hud__cta:hover {
    background: #fff;
  }

  .hud__cta-arrow {
    transition: transform var(--dur) var(--ease-out);
  }

  .hud__cta:hover .hud__cta-arrow {
    transform: translateX(3px);
  }

  /* --- Menu button ----------------------------------------------------- */
  .hud__menu {
    display: none;
    align-items: center;
    gap: 0.5rem;
    height: 2.5rem;
    padding-inline: 0.9rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }

  .hud__menu:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }

  .hud__menu-bars {
    display: grid;
    gap: 4px;
    width: 15px;
  }

  .hud__menu-bars span {
    height: 1px;
    background: currentColor;
    transition: transform var(--dur) var(--ease-out);
  }

  .hud__menu[aria-expanded="true"] .hud__menu-bars span:first-child {
    transform: translateY(2.5px) rotate(45deg);
  }

  .hud__menu[aria-expanded="true"] .hud__menu-bars span:last-child {
    transform: translateY(-2.5px) rotate(-45deg);
  }

  /* --- Mobile menu ----------------------------------------------------- */
  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0;
    z-index: var(--z-overlay);
    background: var(--bg);
    opacity: 0;
    visibility: hidden;
    pointer-events: auto;
    transition:
      opacity var(--dur) var(--ease-out),
      visibility var(--dur) var(--ease-out);
  }

  .mobile-menu.is-open {
    opacity: 1;
    visibility: visible;
  }

  .mobile-menu__inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    padding-block: var(--space-8);
  }

  .mobile-menu__list {
    display: grid;
    gap: var(--space-2);
  }

  .mobile-menu__link {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--border);
  }

  .mobile-menu__index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent);
  }

  .mobile-menu__label {
    font-family: var(--font-display);
    font-size: var(--display-sm);
    letter-spacing: var(--tracking-tighter);
  }

  .mobile-menu__foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    padding-top: var(--space-6);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  /* --- Responsive ------------------------------------------------------ */
  @media (max-width: 1000px) {
    .hud__nav {
      display: none;
    }

    .hud__menu {
      display: inline-flex;
    }
  }

  @media (max-width: 720px) {
    .hud__status {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .hud__cta-text {
      display: none;
    }

    .hud__cta {
      padding-inline: 0.75rem;
    }

    .hud__name {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hud__dot {
      animation: none;
    }
  }
</style>