---
import { profile } from "../../data/profile.js";

const home = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer__inner">
    <div class="footer__meta">
      <span class="mono">© {year} {profile.name}</span>
      <span class="mono footer__built">Designed &amp; built in {profile.location.split(",")[0]}</span>
    </div>

    <ul class="footer__links">
      {
        profile.links.map((link) => (
          <li>
            <a class="text-link" href={link.href} rel="noopener">
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a class="text-link" href={`${home}resume/`}>Resume</a>
      </li>
      <li>
        <a class="text-link footer__top" href={`${home}#top`}>Back to top ↑</a>
      </li>
    </ul>
  </div>

  <p class="footer__mark" aria-hidden="true">
    <span>{profile.firstName}</span><span class="serif">{profile.lastName}</span>
  </p>
</footer>

<style>
  .site-footer {
    padding-top: var(--space-7);
    border-top: 1px solid var(--border);
    overflow: hidden;
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .footer__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
  }

  .footer__built {
    color: var(--text-tertiary);
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    font-size: var(--text-sm);
  }

  .footer__top {
    color: var(--text-secondary);
  }

  .footer__mark {
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: 0.06em;
    margin-top: var(--space-7);
    margin-bottom: -0.2em;
    font-family: var(--font-display);
    font-size: clamp(4rem, 17.5vw, 20rem);
    font-weight: 600;
    line-height: 0.8;
    letter-spacing: -0.065em;
    text-transform: uppercase;
    white-space: nowrap;
    color: transparent;
    background: linear-gradient(180deg, var(--text) 10%, rgba(241, 237, 228, 0.04) 95%);
    -webkit-background-clip: text;
    background-clip: text;
    user-select: none;
  }

  .footer__mark .serif {
    text-transform: none;
    font-size: 1.04em;
    letter-spacing: -0.02em;
  }

  @media (max-width: 640px) {
    .footer__inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
