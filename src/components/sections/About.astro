---
import Section from "../ui/Section.astro";
import { profile } from "../../data/profile.js";
import education from "../../data/education.js";
import certifications from "../../data/certifications.js";
---

<Section
  id="about"
  index="05"
  label="About"
  title="The longer version."
>
  <div class="about">
    <p class="about__statement" data-reveal data-reveal-y="36">
      {profile.summary}
    </p>

    <div class="about__details" data-reveal-group data-stagger="0.1">
      <div class="about__block" data-reveal>
        <h3 class="about__label">Education</h3>
        <ul class="about__list">
          {
            education.map((item) => (
              <li class="about__entry">
                <span class="about__entry-title">{item.qualification}</span>
                <span class="about__entry-meta">
                  {item.institution} · {item.period}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="about__block" data-reveal>
        <h3 class="about__label">Certifications</h3>
        <ul class="about__list">
          {
            certifications.map((item) => (
              <li class="about__entry">
                <span class="about__entry-title">{item.name}</span>
                <span class="about__entry-meta">
                  {item.issuer} · {item.year}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="about__block" data-reveal>
        <h3 class="about__label">Based in</h3>
        <p class="about__entry-title">{profile.location}</p>
      </div>
    </div>
  </div>
</Section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: start;
  }

  .about__statement {
    font-size: clamp(1.1rem, 1rem + 0.7vw, 1.5rem);
    line-height: var(--leading-relaxed);
    letter-spacing: var(--tracking-tight);
    color: var(--text-secondary);
    max-width: 46ch;
  }

  .about__details {
    display: grid;
    gap: clamp(1.75rem, 4vw, 2.75rem);
    padding-top: var(--space-2);
  }

  .about__block {
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }

  .about__label {
    margin-bottom: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .about__list {
    display: grid;
    gap: var(--space-4);
  }

  .about__entry {
    display: grid;
    gap: var(--space-1);
  }

  .about__entry-title {
    font-family: var(--font-display);
    font-size: var(--text-md);
    letter-spacing: var(--tracking-tight);
  }

  .about__entry-meta {
    font-size: var(--text-sm);
    color: var(--text-tertiary);
  }

  @media (max-width: 860px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-7);
    }
  }
</style>