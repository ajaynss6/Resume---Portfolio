---
import SplitText from "../ui/SplitText.astro";
import { profile, bookingHref } from "../../data/profile.js";

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

// Headline proof, shown right under the pitch.
const proof = [
  { value: "5M+", label: "Daily players supported" },
  { value: "$45M+", label: "Annual revenue portfolio" },
  { value: "8 yrs", label: "Product & analytics" },
];
---

<section class="hero" id="top" data-player-host>
  <canvas class="hero__field" data-player-field data-total="5000000" aria-hidden="true"></canvas>

  <div class="container hero__inner">
    <div class="hero__top" data-reveal>
      <span class="eyebrow">{profile.headline}</span>
      <span class="hero__avail mono">
        <span class="hero__dot" aria-hidden="true"></span>
        Open to PM roles
      </span>
    </div>

    <h1 class="hero__title display">
      <SplitText text={profile.firstName} class="hero__line" />
      <SplitText text={profile.lastName} class="hero__line hero__line--indent" />
    </h1>

    <div class="hero__body">
      <p class="hero__statement" data-reveal data-reveal-delay="0.15">
        Product analyst who <span class="serif">builds</span> and already does
        the PM job. Eight years across live games, startup product work, and
        consumer apps I build with AI.
      </p>

      <div class="hero__actions" data-reveal data-reveal-delay="0.25">
        <a class="button button--primary" href="#work">
          See the work
          <span aria-hidden="true">↓</span>
        </a>
        <a class="button" href={`${base}${profile.resumePdf}`} download>Resume (PDF)</a>
        <a class="button button--ghost" href={bookingHref}>Book a call</a>
      </div>
    </div>
  </div>

  <div class="hero__foot container" data-reveal data-reveal-delay="0.35">
    <dl class="hero__proof">
      {
        proof.map((item) => (
          <div class="hero__stat">
            <dt class="mono">{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))
      }
    </dl>
    <p class="hero__legend mono">
      <span class="hero__legend-swatch" aria-hidden="true"></span>
      <span data-player-legend>1 dot = 1,000 daily players</span>
    </p>
  </div>
</section>

<script>
  import "../../scripts/player-field.js";
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-8);
    padding-block: calc(var(--header-h) + clamp(2rem, 6vh, 4rem)) var(--space-6);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__field {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    touch-action: pan-y;
  }

  .hero__inner {
    display: grid;
    gap: clamp(1.5rem, 4vh, 2.75rem);
  }

  .hero__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .hero__avail {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text);
  }

  .hero__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 12px var(--accent);
  }

  .hero__title {
    font-size: var(--display-lg);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: -0.055em;
    line-height: 0.84;
    pointer-events: none;
  }

  .hero__title :global(.hero__line--indent) {
    padding-left: 0.62em;
  }

  .hero__body {
    display: grid;
    gap: var(--space-6);
    max-width: 40rem;
  }

  .hero__statement {
    max-width: 32ch;
    font-size: var(--text-xl);
    line-height: 1.3;
    letter-spacing: var(--tracking-tight);
    color: var(--text-secondary);
  }

  .hero__statement .serif {
    color: var(--text);
    font-size: 1.1em;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .hero__proof {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.5rem, 5vw, 4rem);
  }

  .hero__stat {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-1);
    padding-left: var(--space-4);
    border-left: 1px solid var(--accent-line);
  }

  .hero__stat dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.2rem + 1.8vw, 2.75rem);
    font-weight: 500;
    letter-spacing: var(--tracking-tighter);
    line-height: 1;
  }

  .hero__legend {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .hero__legend-swatch {
    width: 4px;
    height: 4px;
    background: var(--text);
    box-shadow: 8px 0 0 var(--accent);
    margin-right: 8px;
  }

  @media (max-width: 899px) {
    .hero__inner {
      padding-top: 38svh;
    }

    .hero__top {
      position: absolute;
      top: calc(var(--header-h) + 1.25rem);
      left: var(--gutter);
      right: var(--gutter);
    }
  }

  @media (max-width: 640px) {
    .hero__title {
      font-size: 21vw;
    }

    .hero__statement {
      font-size: var(--text-lg);
    }

    /* Impact follows immediately on mobile; avoid repeating the numbers. */
    .hero__proof,
    .hero__legend {
      display: none;
    }
  }
</style>
