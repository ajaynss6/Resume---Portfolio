---
// Diagrammatic artwork per project. Each variant depicts what the project
// actually is (six modules, three agents, a self-serve question, a wall of
// dashboards, an anomaly on a revenue line) rather than decorative noise.
// Purely presentational: hidden from assistive tech.
const { variant = "modules", index = "01" } = Astro.props;

const modules = ["Analytics", "Segments", "A/B tests", "Remote config", "AI insights", "Live-ops"];
const agents = [
  { x: 70, y: 70, label: "Performance" },
  { x: 330, y: 70, label: "Monetization" },
  { x: 200, y: 250, label: "Hypothesis" },
];

// Deterministic pseudo-random series so the art is stable between builds.
let s = 11;
const rnd = () => ((s = (s * 16807) % 2147483647) - 1) / 2147483646;
const spark = () =>
  Array.from({ length: 12 }, (_, i) => `${i * 8},${20 - rnd() * 16}`).join(" ");
const sparks = Array.from({ length: 20 }, spark);
const revenue = Array.from({ length: 24 }, (_, i) => {
  const y = 170 - i * 3.2 - Math.sin(i / 2) * 14 - (i === 15 ? -62 : 0);
  return [24 + i * 15.5, y];
});
const revenuePath = revenue.map(([x, y], i) => `${i ? "L" : "M"}${x},${y}`).join(" ");
const bars = [38, 64, 52, 88, 71, 112, 96];
---

<div class="visual" data-work-visual-inner data-variant={variant} aria-hidden="true">
  <span class="visual__index">{index}</span>
  <svg viewBox="0 0 400 300" class="visual__svg" role="presentation">
    {
      variant === "modules" && (
        <g>
          {modules.map((label, i) => {
            const x = 28 + (i % 3) * 120;
            const y = 52 + Math.floor(i / 3) * 112;
            return (
              <g class:list={["tile", i === 4 && "tile--lit"]} style={`--d:${i * 0.12}s`}>
                <rect x={x} y={y} width="104" height="92" rx="10" />
                <text x={x + 12} y={y + 24} class="t-mono">{`0${i + 1}`}</text>
                <text x={x + 12} y={y + 78} class="t-label t-small">{label}</text>
              </g>
            );
          })}
        </g>
      )
    }
    {
      variant === "agents" && (
        <g>
          {agents.map((a) => (
            <line x1={a.x} y1={a.y} x2="200" y2="140" class="wire" />
          ))}
          <circle cx="200" cy="140" r="34" class="core" />
          <text x="200" y="145" text-anchor="middle" class="t-label t-dark">Insight</text>
          {agents.map((a, i) => (
            <g class="agent" style={`--d:${i * 0.4}s`}>
              <circle cx={a.x} cy={a.y} r="24" />
              <text x={a.x} y={a.y + 5} text-anchor="middle" class="t-mono">{`A${i + 1}`}</text>
              <text x={a.x} y={a.y + (a.y > 200 ? 44 : -34)} text-anchor="middle" class="t-label">{a.label}</text>
            </g>
          ))}
        </g>
      )
    }
    {
      variant === "selfserve" && (
        <g>
          <rect x="28" y="36" width="344" height="48" rx="24" class="prompt" />
          <text x="52" y="66" class="t-label">Why did D7 retention dip last week?</text>
          <rect x="342" y="46" width="2" height="28" class="caret" />
          {bars.map((h, i) => (
            <rect x={44 + i * 46} y={262 - h} width="30" height={h} rx="4" class:list={["bar", i === 3 && "bar--lit"]} style={`--d:${i * 0.08}s`} />
          ))}
          <line x1="28" y1="262" x2="372" y2="262" class="axis" />
        </g>
      )
    }
    {
      variant === "dashboards" && (
        <g>
          {sparks.map((points, i) => {
            const x = 22 + (i % 5) * 74;
            const y = 34 + Math.floor(i / 5) * 62;
            return (
              <g transform={`translate(${x} ${y})`} class:list={["spark", i === 7 && "spark--lit"]}>
                <rect width="64" height="50" rx="6" />
                <polyline points={points} transform="translate(6 18) scale(0.6)" />
              </g>
            );
          })}
        </g>
      )
    }
    {
      variant === "monetization" && (
        <g>
          {[70, 130, 190, 250].map((y) => (
            <line x1="24" y1={y} x2="380" y2={y} class="grid" />
          ))}
          <path d={revenuePath} class="line" pathLength="1" />
          <circle cx={revenue[15][0]} cy={revenue[15][1]} r="16" class="ring" />
          <circle cx={revenue[15][0]} cy={revenue[15][1]} r="4" class="dot" />
          <text x={revenue[15][0] + 22} y={revenue[15][1] + 4} class="t-mono t-signal">anomaly</text>
        </g>
      )
    }
  </svg>
</div>

<style>
  .visual {
    position: relative;
    aspect-ratio: 4 / 3;
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background:
      radial-gradient(120% 90% at 0% 0%, rgba(200, 255, 61, 0.06), transparent 60%),
      var(--bg-elev);
    transform-style: preserve-3d;
    will-change: transform;
  }

  .visual__index {
    position: absolute;
    right: 0.9rem;
    bottom: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
  }

  .visual__svg {
    width: 100%;
    height: 100%;
  }

  .t-mono {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--text-tertiary);
  }

  .t-label {
    font-family: var(--font-display);
    font-size: 14px;
    fill: var(--text);
  }

  .t-small {
    font-size: 12px;
  }

  .t-dark {
    fill: var(--text-inverse);
    font-weight: 600;
  }

  .t-signal {
    fill: var(--accent);
  }

  /* Modules */
  .tile rect {
    fill: var(--surface);
    stroke: var(--border-strong);
  }

  .tile--lit rect {
    fill: var(--accent-soft);
    stroke: var(--accent);
  }

  .tile--lit .t-mono {
    fill: var(--accent);
  }

  /* Agents */
  .wire {
    stroke: var(--accent-line);
    stroke-width: 1.2;
    stroke-dasharray: 4 6;
    animation: flow 1.6s linear infinite;
  }

  .core {
    fill: var(--accent);
  }

  .agent circle {
    fill: var(--bg);
    stroke: var(--border-strong);
  }

  /* Self-serve */
  .prompt {
    fill: var(--surface);
    stroke: var(--border-strong);
  }

  .caret {
    fill: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  .bar {
    fill: var(--border-strong);
  }

  .bar--lit {
    fill: var(--accent);
  }

  .axis,
  .grid {
    stroke: var(--border);
  }

  /* Dashboards */
  .spark rect {
    fill: var(--surface);
    stroke: var(--border);
  }

  .spark polyline {
    fill: none;
    stroke: var(--text-tertiary);
    stroke-width: 2.4;
  }

  .spark--lit rect {
    stroke: var(--accent);
  }

  .spark--lit polyline {
    stroke: var(--accent);
  }

  /* Monetization */
  .line {
    fill: none;
    stroke: var(--text);
    stroke-width: 2;
  }

  .ring {
    fill: none;
    stroke: var(--accent);
    animation: ping 2.4s var(--ease-out) infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  .dot {
    fill: var(--accent);
  }

  @keyframes flow {
    to {
      stroke-dashoffset: -20;
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @keyframes ping {
    from {
      transform: scale(0.6);
      opacity: 1;
    }
    to {
      transform: scale(1.8);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wire,
    .caret,
    .ring {
      animation: none;
    }
  }
</style>
