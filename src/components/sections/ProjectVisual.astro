---
// Abstract, generative placeholder artwork for a project.
// Not a fake screenshot — a geometric composition that scales and tilts on
// hover. Replace with real imagery later by swapping this component.
const { index = "01", accent = "#8ea6ff", tone = "#1b2440", label = "" } =
  Astro.props;
---

<div
  class="visual"
  data-work-visual-inner
  style={`--v-accent:${accent};--v-tone:${tone}`}
>
  <div class="visual__grid" aria-hidden="true"></div>
  <div class="visual__glow" aria-hidden="true"></div>
  <div class="visual__ring" aria-hidden="true"></div>
  <span class="visual__index" aria-hidden="true">{index}</span>
  {label && <span class="visual__label" aria-hidden="true">{label}</span>}
</div>

<style>
  .visual {
    position: relative;
    aspect-ratio: 4 / 3;
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background:
      linear-gradient(160deg, var(--v-tone) 0%, var(--bg-elev) 78%);
    transform-style: preserve-3d;
    will-change: transform;
  }

  .visual__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size: 34px 34px;
    mask-image: linear-gradient(180deg, #000, transparent 85%);
    -webkit-mask-image: linear-gradient(180deg, #000, transparent 85%);
  }

  .visual__glow {
    position: absolute;
    top: -35%;
    left: -20%;
    width: 90%;
    height: 90%;
    background: radial-gradient(
      circle at center,
      color-mix(in srgb, var(--v-accent) 55%, transparent) 0%,
      transparent 62%
    );
    filter: blur(6px);
    opacity: 0.75;
  }

  .visual__ring {
    position: absolute;
    right: -18%;
    bottom: -30%;
    width: 68%;
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--v-accent) 45%, transparent);
    border-radius: 50%;
  }

  .visual__ring::after {
    content: "";
    position: absolute;
    inset: 16%;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 50%;
  }

  .visual__index {
    position: absolute;
    left: 1rem;
    bottom: 0.75rem;
    font-family: var(--font-mono);
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1;
    color: color-mix(in srgb, var(--v-accent) 80%, white);
    opacity: 0.85;
  }

  .visual__label {
    position: absolute;
    top: 1rem;
    left: 1rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
  }
</style>