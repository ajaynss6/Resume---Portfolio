---
// Diagrammatic artwork per project. Each variant depicts what the project
// actually is (a de-duplicated ledger, a workout logger, a wall of
// dashboards, an anomaly on a revenue line, a forecast with its band, a
// season of events, volume against capacity, a turbine's failure signal).
// Purely presentational: hidden from assistive tech.
const { variant = "ledger", index = "01" } = Astro.props;



// Deterministic pseudo-random series so the art is stable between builds.
let s = 11;
const rnd = () => ((s = (s * 16807) % 2147483647) - 1) / 2147483646;
const spark = () =>
  Array.from({ length: 12 }, (_, i) => `${i * 8},${20 - rnd() * 16}`).join(" ");
const sparks = Array.from({ length: 20 }, spark);
const revenue = Array.from({ length: 24 }, (_, i) => {
  const y = 170 - i * 3.2 - Math.sin(i / 2) * 14 - (i === 15 ? -62 : 0);
  return [24 + i * 15.5, y];
});
const revenuePath = revenue.map(([x, y], i) => `${i ? "L" : "M"}${x},${y}`).join(" ");
const sources = [
  { y: 40, title: "Gmail · bank alert", line: "₹1,240 · Swiggy" },
  { y: 122, title: "Statement line", line: "₹1,240 · SWIGGY*ORDER" },
  { y: 204, title: "Receipt", line: "₹1,240 · order #4471" },
];
// Forecast: actuals, then a projection with a widening band.
const fcActual = Array.from({ length: 14 }, (_, i) => [24 + i * 14, 190 - i * 3.4 - Math.sin(i * 0.9) * 16]);
const fcLast = fcActual[fcActual.length - 1];
const fcAhead = Array.from({ length: 10 }, (_, i) => {
  const x = fcLast[0] + (i + 1) * 14;
  const y = fcLast[1] - (i + 1) * 3.6 - Math.sin((i + 14) * 0.9) * 10;
  return [x, y, 6 + i * 3.2];
});
const fcLine = fcActual.map(([x, y], i) => `${i ? "L" : "M"}${x},${y}`).join(" ");
const fcProj = [fcLast, ...fcAhead].map(([x, y], i) => `${i ? "L" : "M"}${x},${y}`).join(" ");
const fcBand =
  [fcLast, ...fcAhead].map(([x, y, w = 0], i) => `${i ? "L" : "M"}${x},${y - w}`).join(" ") +
  " " +
  [...fcAhead].reverse().map(([x, y, w]) => `L${x},${y + w}`).join(" ") +
  ` L${fcLast[0]},${fcLast[1]} Z`;

// Events: a season of weeks as a heatmap, with event weeks marked.
const evCells = Array.from({ length: 7 * 16 }, (_, i) => {
  const week = Math.floor(i / 7);
  const day = i % 7;
  const season = 0.35 + 0.3 * Math.sin(week / 2.4) + (day > 4 ? 0.15 : 0) + rnd() * 0.15;
  return { x: 36 + week * 21, y: 64 + day * 21, v: Math.min(1, Math.max(0.08, season)), event: [4, 10, 13].includes(week) };
});

// Capacity: daily volume bars against a capacity line.
const capBars = Array.from({ length: 14 }, (_, i) => {
  const v = 70 + Math.sin(i / 1.6) * 34 + (i === 5 || i === 11 ? 58 : 0) + rnd() * 18;
  return { x: 34 + i * 25, h: v, over: v > 140 };
});

// Turbine: sensor signal with a rising anomaly before failure.
const tbSignal = Array.from({ length: 30 }, (_, i) => {
  const drift = i > 21 ? (i - 21) * 5.5 : 0;
  return [150 + i * 8, 236 - Math.sin(i * 1.3) * 6 - rnd() * 6 - drift];
});
const tbPath = tbSignal.map(([x, y], i) => `${i ? "L" : "M"}${x},${y}`).join(" ");

const sets = [
  { y: 62, text: "40 kg × 8", state: "done" },
  { y: 106, text: "40 kg × 8", state: "done" },
  { y: 150, text: "42.5 kg × 6", state: "active" },
  { y: 194, text: "42.5 kg × 6", state: "todo" },
];
---

<div class="visual" data-work-visual-inner data-variant={variant} aria-hidden="true">
  <span class="visual__index">{index}</span>
  <svg viewBox="0 0 400 300" class="visual__svg" role="presentation">
    {
      variant === "forecast" && (
        <g>
          {[80, 130, 180, 230].map((y) => (
            <line x1="24" y1={y} x2="380" y2={y} class="grid" />
          ))}
          <path d={fcBand} class="band" />
          <path d={fcLine} class="line" />
          <path d={fcProj} class="proj" />
          <line x1={fcLast[0]} y1="52" x2={fcLast[0]} y2="250" class="today" />
          <text x={fcLast[0] + 6} y="62" class="t-mono">today</text>
          <text x="28" y="40" class="t-label t-small">Weekly KPI · market A</text>
          <text x={fcAhead[fcAhead.length - 1][0] - 4} y={fcAhead[fcAhead.length - 1][1] - 34} text-anchor="end" class="t-mono t-signal">
            forecast
          </text>
        </g>
      )
    }
    {
      variant === "events" && (
        <g>
          <text x="36" y="40" class="t-label t-small">Season · weeks × days</text>
          {evCells.map((c) => (
            <rect x={c.x} y={c.y} width="17" height="17" rx="3" class:list={["cell", c.event && "cell--event"]} style={`--v:${c.v}`} />
          ))}
          {[4, 10, 13].map((w, i) => (
            <g>
              <line x1={36 + w * 21 + 8.5} y1="214" x2={36 + w * 21 + 8.5} y2="232" class="tick" />
              <text x={36 + w * 21 + 8.5} y="248" text-anchor="middle" class="t-mono t-signal">{["sale", "holiday", "event"][i]}</text>
            </g>
          ))}
        </g>
      )
    }
    {
      variant === "capacity" && (
        <g>
          <text x="34" y="40" class="t-label t-small">Volume per day · DC</text>
          <line x1="24" y1="252" x2="384" y2="252" class="grid" />
          {capBars.map((b) => (
            <rect x={b.x} y={252 - b.h} width="17" height={b.h} rx="3" class:list={["bar", b.over && "bar--over"]} />
          ))}
          <line x1="24" y1="112" x2="384" y2="112" class="cap" />
          <text x="384" y="104" text-anchor="end" class="t-mono t-warn">capacity</text>
        </g>
      )
    }
    {
      variant === "turbine" && (
        <g>
          <line x1="84" y1="120" x2="78" y2="262" class="tower" />
          <line x1="84" y1="120" x2="90" y2="262" class="tower" />
          <g class="rotor" style="transform-origin: 84px 118px">
            {[0, 120, 240].map((deg) => (
              <path d="M84,118 C88,96 90,74 84,46 C80,74 80,96 84,118 Z" class="blade" transform={`rotate(${deg} 84 118)`} />
            ))}
          </g>
          <circle cx="84" cy="118" r="5" class="hub" />
          <text x="150" y="40" class="t-label t-small">Gearbox vibration</text>
          {[120, 170, 220].map((y) => (
            <line x1="150" y1={y} x2="384" y2={y} class="grid" />
          ))}
          <path d={tbPath} class="line" />
          <circle cx={tbSignal[27][0]} cy={tbSignal[27][1]} r="14" class="ring" />
          <text x={tbSignal[27][0] - 8} y={tbSignal[27][1] - 22} text-anchor="end" class="t-mono t-signal">predicted failure</text>
        </g>
      )
    }
    {
      variant === "dashboards" && (
        <g>
          {sparks.map((points, i) => {
            const x = 22 + (i % 5) * 74;
            const y = 34 + Math.floor(i / 5) * 62;
            return (
              <g transform={`translate(${x} ${y})`} class:list={["spark", i === 7 && "spark--lit"]}>
                <rect width="64" height="50" rx="6" />
                <polyline points={points} transform="translate(6 18) scale(0.6)" />
              </g>
            );
          })}
        </g>
      )
    }
    {
      variant === "monetization" && (
        <g>
          {[70, 130, 190, 250].map((y) => (
            <line x1="24" y1={y} x2="380" y2={y} class="grid" />
          ))}
          <path d={revenuePath} class="line" pathLength="1" />
          <circle cx={revenue[15][0]} cy={revenue[15][1]} r="16" class="ring" />
          <circle cx={revenue[15][0]} cy={revenue[15][1]} r="4" class="dot" />
          <text x={revenue[15][0] + 22} y={revenue[15][1] + 4} class="t-mono t-signal">anomaly</text>
        </g>
      )
    }
    {
      variant === "ledger" && (
        <g>
          {sources.map((src, i) => (
            <g class="source" style={`--d:${i * 0.3}s`}>
              <rect x="20" y={src.y} width="156" height="56" rx="8" />
              <text x="32" y={src.y + 22} class="t-mono">{src.title}</text>
              <text x="32" y={src.y + 42} class="t-label t-small">{src.line}</text>
              <path d={`M176 ${src.y + 28} C 201 ${src.y + 28}, 201 150, 226 150`} class="merge" />
            </g>
          ))}
          <rect x="226" y="118" width="160" height="64" rx="10" class="record" />
          <text x="240" y="142" class="t-label">Swiggy · ₹1,240</text>
          <text x="240" y="166" class="t-mono t-signal">1 payment, 3 proofs</text>
          <circle cx="330" cy="60" r="24" class="score-track" />
          <circle cx="330" cy="60" r="24" class="score-arc" pathLength="100" transform="rotate(-90 330 60)" />
          <text x="330" y="64" text-anchor="middle" class="t-mono">score</text>
        </g>
      )
    }
    {
      variant === "workout" && (
        <g>
          <text x="24" y="40" class="t-label">Bench press</text>
          <text x="226" y="40" class="t-mono" text-anchor="end">set · load</text>
          {sets.map((set, i) => (
            <g class:list={["set", `set--${set.state}`]}>
              <rect x="20" y={set.y} width="216" height="36" rx="8" />
              <text x="34" y={set.y + 23} class="t-mono">{i + 1}</text>
              <text x="56" y={set.y + 23} class="t-label t-small">{set.text}</text>
              {set.state === "done" && <text x="216" y={set.y + 23} text-anchor="end" class="t-mono t-signal">✓</text>}
              {set.state === "active" && (
                <g>
                  <rect x="164" y={set.y + 7} width="64" height="22" rx="11" class="log" />
                  <text x="196" y={set.y + 22} text-anchor="middle" class="t-mono t-dark">Log set</text>
                </g>
              )}
            </g>
          ))}
          <circle cx="314" cy="146" r="46" class="score-track" />
          <circle cx="314" cy="146" r="46" class="timer-arc" pathLength="100" transform="rotate(-90 314 146)" />
          <text x="314" y="148" text-anchor="middle" class="t-label">1:30</text>
          <text x="314" y="166" text-anchor="middle" class="t-mono">rest</text>
        </g>
      )
    }
  </svg>
</div>

<style>
  .visual {
    position: relative;
    aspect-ratio: 4 / 3;
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background:
      radial-gradient(120% 90% at 0% 0%, rgba(200, 255, 61, 0.06), transparent 60%),
      var(--bg-elev);
    transform-style: preserve-3d;
    will-change: transform;
  }

  .visual__index {
    position: absolute;
    right: 0.9rem;
    bottom: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-tertiary);
  }

  .visual__svg {
    width: 100%;
    height: 100%;
  }

  .t-mono {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--text-tertiary);
  }

  .t-label {
    font-family: var(--font-display);
    font-size: 14px;
    fill: var(--text);
  }

  .t-small {
    font-size: 12px;
  }

  .t-dark {
    fill: var(--text-inverse);
    font-weight: 600;
  }

  .t-signal {
    fill: var(--accent);
  }

  .grid {
    stroke: var(--border);
  }

  /* Forecast */
  .band {
    fill: var(--accent-soft);
  }

  .proj {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-dasharray: 5 5;
  }

  .today {
    stroke: var(--border-strong);
    stroke-dasharray: 2 4;
  }

  /* Events */
  .cell {
    fill: var(--text);
    fill-opacity: calc(var(--v) * 0.45);
  }

  .cell--event {
    fill: var(--accent);
    fill-opacity: calc(0.35 + var(--v) * 0.65);
  }

  .tick {
    stroke: var(--accent-line);
  }

  /* Capacity */
  .bar {
    fill: var(--border-strong);
  }

  .bar--over {
    fill: var(--highlight);
  }

  .cap {
    stroke: var(--highlight);
    stroke-width: 1.5;
    stroke-dasharray: 6 5;
  }

  .t-warn {
    fill: var(--highlight);
  }

  /* Turbine */
  .tower {
    stroke: var(--text-tertiary);
    stroke-width: 2;
  }

  .blade {
    fill: var(--text);
    fill-opacity: 0.85;
  }

  .hub {
    fill: var(--accent);
  }

  .rotor {
    animation: spin 9s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Dashboards */
  .spark rect {
    fill: var(--surface);
    stroke: var(--border);
  }

  .spark polyline {
    fill: none;
    stroke: var(--text-tertiary);
    stroke-width: 2.4;
  }

  .spark--lit rect {
    stroke: var(--accent);
  }

  .spark--lit polyline {
    stroke: var(--accent);
  }

  /* Ledger */
  .source rect {
    fill: var(--surface);
    stroke: var(--border-strong);
  }

  .merge {
    fill: none;
    stroke: var(--accent-line);
    stroke-width: 1.2;
    stroke-dasharray: 4 6;
    animation: flow 1.6s linear infinite;
  }

  .record {
    fill: var(--accent-soft);
    stroke: var(--accent);
  }

  .score-track {
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 4;
  }

  .score-arc,
  .timer-arc {
    fill: none;
    stroke: var(--accent);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-dasharray: 72 100;
  }

  /* Workout */
  .set rect {
    fill: var(--surface);
    stroke: var(--border);
  }

  .set--active > rect {
    stroke: var(--accent);
  }

  .set--todo {
    opacity: 0.45;
  }

  .set .log {
    fill: var(--accent);
    stroke: none;
  }

  .timer-arc {
    stroke-dasharray: 60 100;
    animation: tick 6s linear infinite;
  }

  @keyframes tick {
    from {
      stroke-dasharray: 100 100;
    }
    to {
      stroke-dasharray: 0 100;
    }
  }

  /* Monetization */
  .line {
    fill: none;
    stroke: var(--text);
    stroke-width: 2;
  }

  .ring {
    fill: none;
    stroke: var(--accent);
    animation: ping 2.4s var(--ease-out) infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  .dot {
    fill: var(--accent);
  }

  @keyframes flow {
    to {
      stroke-dashoffset: -20;
    }
  }


  @keyframes ping {
    from {
      transform: scale(0.6);
      opacity: 1;
    }
    to {
      transform: scale(1.8);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ring,
    .merge,
    .timer-arc,
    .rotor {
      animation: none;
    }
  }
</style>
