---
import Section from "../ui/Section.astro";
import TagList from "../ui/TagList.astro";
import projects from "../../data/projects.js";
---

<Section id="projects" title="Projects" subtitle="Selected product and analytics work.">
  <ul class="grid">
    {
      projects.map((project) => (
        <li class="card">
          <h3 class="card__title">{project.title}</h3>
          {project.context && <p class="card__meta">{project.context}</p>}
          <p class="card__body">{project.description}</p>
          <div class="card__tags">
            <TagList tags={project.tags} label={`${project.title} tags`} />
          </div>
        </li>
      ))
    }
  </ul>
</Section>