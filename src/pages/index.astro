---
import BaseLayout from "../components/layout/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import Work from "../components/sections/Work.astro";
import Experience from "../components/sections/Experience.astro";
import Capabilities from "../components/sections/Capabilities.astro";
import Metrics from "../components/sections/Metrics.astro";
import About from "../components/sections/About.astro";
import Contact from "../components/sections/Contact.astro";
import Ticker from "../components/ui/Ticker.astro";
import Thread from "../components/ui/Thread.astro";

const franchises = [
  "Bejeweled",
  "Plants vs. Zombies",
  "Need for Speed No Limits",
  "The Sims Mobile",
  "Electronic Arts",
  "Liquidnitro Games",
  "AI-built apps",
  "Live services",
];
---

<BaseLayout>
  <Thread />
  <Hero />
  <Ticker items={franchises} label="Games and teams worked on" />
  <Metrics />
  <Work
    id="work"
    title="Work that *shipped* at scale."
    aside="Live-services analytics at Electronic Arts, and decision science for Fortune 500 clients at Mu Sigma."
    groups={["ea", "musigma"]}
    filters={[
      { id: "ea", label: "Electronic Arts" },
      { id: "musigma", label: "Mu Sigma" },
    ]}
  />
  <Work
    id="projects"
    title="Things I *build* on my own."
    aside="Consumer apps, data products and tools I take from idea to working product with AI coding agents."
    groups={["personal"]}
  />
  <Experience />
  <Capabilities />
  <About />
  <Contact />
</BaseLayout>